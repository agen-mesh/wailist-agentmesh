<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Backups off: this app persists a bearer token, and @capacitor/preferences
         stores it in PLAIN SharedPreferences, not encrypted. With backups on,
         that token can be lifted out of a device backup and restored onto
         another device. Encrypted storage is the real fix and is tracked
         separately; until then, do not hand the token to the backup agent. -->
    <!-- Opts into Android's predictive back gesture, which draws a preview of
         where the swipe is about to take you rather than moving only once you
         let go. Required on Android 14; the default from 15, so this is here for
         the 14 devices this app still supports (minSdk 23).

         Deliberately NOT paired with an App.addListener("backButton") handler.
         Capacitor already navigates the WebView's history on back and finishes
         the activity at the root, which is the behaviour we want, and
         registering a listener REPLACES that default rather than extending it.
         Hand-rolling what the bridge already gets right is a regression waiting
         to happen. -->
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Receives geofence transitions from the OS. Not exported: only
             Play Services delivers to it, and an exported receiver would let
             any app on the device forge a crossing. -->
        <receiver
            android:name=".GeofenceReceiver"
            android:exported="false" />

        <!-- Re-registers the active fence after a reboot, because
             GeofencingClient does not persist registrations across one. Not
             exported: only the system can send a protected broadcast, so
             BOOT_COMPLETED never needs an exported receiver to reach it. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Geofencing. BACKGROUND_LOCATION is a separate, later grant on Android
         10+, and without it a fence only holds while the app is open, which
         is not a geofence anybody wants. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- So registered fences survive a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>

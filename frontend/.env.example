# Public browser API prefix. Empty selects the existing demo data mode.
NEXT_PUBLIC_API_URL=/api
# Server-only destination for the Next.js API proxy.
BACKEND_URL=http://127.0.0.1:8080
# Public Tiramisu RPC for provider-owned Arkiv wallet writes.
# Leave blank to disable provider publication. Never put credentials here.
NEXT_PUBLIC_ARKIV_RPC_URL=

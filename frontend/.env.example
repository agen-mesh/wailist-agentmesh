# Public base URL of the Go backend.
# Inlined into the bundle at BUILD time — a redeploy is required after changing it.
# Leave empty to run the frontend in mock mode (no backend calls).
NEXT_PUBLIC_API_URL=https://wailist-agentmesh-production-f943.up.railway.app


# Server-only share previews. Use the backend HTTPS origin with no path.
BACKEND_URL=https://wailist-agentmesh-production-f943.up.railway.app
# Dedicated 32-byte hex key, identical on frontend and backend.
# Generate privately: openssl rand -hex 32. Never prefix with NEXT_PUBLIC_.
SHARE_READ_RELAY_KEY=
# VERCEL=1 is supplied by Vercel. Do not set it on a public self-hosted server.
# See docs/share-read-relay.md for the visitor trust and deployment contract.

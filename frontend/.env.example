# Public base URL of the Go backend.
# Inlined into the bundle at BUILD time — a redeploy is required after changing it.
# Leave empty to run the frontend in mock mode (no backend calls).
NEXT_PUBLIC_API_URL=https://wailist-agentmesh-production.up.railway.app

# Target URL for the "Load demo workflow" button on the Workflows page.
# Defaults to Prism's real mainnet x402 endpoint. Must be reachable by the
# BACKEND (not just your browser) and not localhost/private — AgentMesh's
# backend blocks those (SSRF guard). Only override for local testing against
# a different target.
NEXT_PUBLIC_X402_DEMO_MERCHANT_URL=

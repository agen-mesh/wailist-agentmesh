# Public base URL of the Go backend.
# Inlined into the bundle at BUILD time — a redeploy is required after changing it.
# Leave empty to run the frontend in mock mode (no backend calls).
NEXT_PUBLIC_API_URL=https://wailist-agentmesh-production-f943.up.railway.app

# Address of ARKIV_SHARE_PRIVATE_KEY. The open page accepts an Arkiv entity
# only when its $creator matches this. Inlined at build time. Never put the key here.
NEXT_PUBLIC_ARKIV_SHARE_ADDRESS=


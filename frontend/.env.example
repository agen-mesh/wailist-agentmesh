# Public base URL of the Go backend.
# Inlined into the bundle at BUILD time — a redeploy is required after changing it.
# Leave empty to run the frontend in mock mode (no backend calls).
NEXT_PUBLIC_API_URL=https://wailist-agentmesh-production-f943.up.railway.app

# Maintenance mode (web only — the native app is a static export and is unaffected).
# Set to "on" to replace every page except /terms, /privacy and /refund-policy
# with the maintenance page. Unset or anything else = site behaves normally.
# Server-only: no NEXT_PUBLIC_ prefix, read by middleware per request.
MAINTENANCE_MODE=
# Shared secret that lets the team through while maintenance is on: open any
# page as /?bypass=<token> once per browser (sets a 7-day HttpOnly cookie);
# /?bypass=off clears it. Use a long random value, e.g. `openssl rand -hex 24`.
# Leave empty and nobody gets through. Rotating it revokes every bypass.
MAINTENANCE_BYPASS_TOKEN=
